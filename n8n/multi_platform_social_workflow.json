      "id": "node-download-hashtags",
      "name": "Google Drive: Download hashtags.txt",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1280, 340]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": "={{ $('Classify Media & Files').first().json.primary_image_id }}"
      },
      "id": "node-download-image-binary",
      "name": "Google Drive: Download Image File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1280, 500]
    },
    {
      "parameters": {
        "jsCode": "// Read caption & hashtags text from binary downloads\nconst meta = $('Classify Media & Files').first().json;\nlet captionText = '';\nlet hashtagsText = '';\n\ntry {\n  const capItem = $('Google Drive: Download caption.txt').first();\n  if (capItem && capItem.binary && capItem.binary.data) {\n    captionText = Buffer.from(capItem.binary.data.data, 'base64').toString('utf8').trim();\n  }\n} catch (e) {}\n\ntry {\n  const hashItem = $('Google Drive: Download hashtags.txt').first();\n  if (hashItem && hashItem.binary && hashItem.binary.data) {\n    hashtagsText = Buffer.from(hashItem.binary.data.data, 'base64').toString('utf8').trim();\n  }\n} catch (e) {}\n\n// Default fallback if caption.txt was empty\nif (!captionText) {\n  captionText = meta.folder_name;\n}\n\nlet fullCaption = captionText;\nif (hashtagsText) {\n  fullCaption += '\\n\\n' + hashtagsText;\n}\n\nreturn {\n  json: {\n    ...meta,\n    caption: captionText,\n    hashtags: hashtagsText,\n    full_caption: fullCaption\n  }\n};"
      },
