      "id": "node-gdrive-list-folders",
      "name": "Google Drive: List Queue Folders",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [560, 300]
    },
    {
      "parameters": {
        "jsCode": "// Sort & pick latest queue subfolder (excluding Archive)\nconst items = $input.all();\nconst validFolders = items.filter(item => {\n  const name = (item.json.name || item.json.title || '').toLowerCase();\n  return name.startsWith('post_') && !name.includes('archive');\n});\n\nif (validFolders.length === 0) {\n  return [];\n}\n\n// Sort descending to get top queue item\nvalidFolders.sort((a, b) => {\n  const nameA = a.json.name || a.json.title || '';\n  const nameB = b.json.name || b.json.title || '';\n  return nameB.localeCompare(nameA);\n});\n\nreturn [validFolders[0]];"
      },
      "id": "node-pick-next-folder",
      "name": "Pick Top Queue Subfolder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "advanced",
        "queryString": "='{{ $('Pick Top Queue Subfolder').first().json.id }}' in parents and trashed = false",
        "options": {}
      },
      "id": "node-gdrive-list-files",
      "name": "Google Drive: List Files in Subfolder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "// Classify media and find caption.txt and hashtags.txt\nconst files = $('Google Drive: List Files in Subfolder').all().map(i => i.json);\n\n// Check mimeType AND file extension (.png, .jpg, .jpeg, .webp)\nconst images = files.filter(f => {\n  const name = (f.name || f.title || '').toLowerCase();\n  const mime = (f.mimeType || f.mime_type || '').toLowerCase();\n  return mime.startsWith('image/') || name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.webp');\n});\n\n// Check mimeType AND file extension (.mp4, .mov, .avi)\nconst videos = files.filter(f => {\n  const name = (f.name || f.title || '').toLowerCase();\n  const mime = (f.mimeType || f.mime_type || '').toLowerCase();\n  return mime.startsWith('video/') || name.endsWith('.mp4') || name.endsWith('.mov') || name.endsWith('.avi');\n});\n\nconst captionFile = files.find(f => (f.name || f.title || '').toLowerCase() === 'caption.txt');\nconst hashtagsFile = files.find(f => (f.name || f.title || '').toLowerCase() === 'hashtags.txt');\n\nconst topFolder = $('Pick Top Queue Subfolder').first().json;\n\nreturn {\n  json: {\n    folder_id: topFolder.id,\n    folder_name: topFolder.name || topFolder.title,\n    media_type: videos.length > 0 ? 'VIDEO' : (images.length > 1 ? 'CAROUSEL' : 'SINGLE_PHOTO'),\n    images: images,\n    videos: videos,\n    caption_file_id: captionFile ? captionFile.id : null,\n    hashtags_file_id: hashtagsFile ? hashtagsFile.id : null,\n    primary_image_url: images.length > 0 ? 'https://lh3.googleusercontent.com/d/' + images[0].id : '',\n    primary_image_id: images.length > 0 ? images[0].id : null\n  }\n};"
      },
      "id": "node-classify-media",
      "name": "Classify Media & Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": "={{ $json.caption_file_id }}"
      },
