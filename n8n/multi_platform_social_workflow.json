{
  "name": "Google Drive Auto-Publisher (Instagram, Facebook, Threads & X)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,14,19 * * *"
            }
          ]
        }
      },
      "id": "node-cron-trigger",
      "name": "Schedule Trigger (9AM, 2PM, 7PM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "advanced",
        "queryString": "'1djXkok8cuP3efyurTd2nOwoKRo-HpEC3' in parents and trashed = false",
        "options": {}
      },
      "id": "node-gdrive-list-folders",
      "name": "Google Drive: List Queue Folders",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "// Sort & pick latest queue subfolder (excluding Archive)\nconst items = $input.all();\nconst validFolders = items.filter(item => {\n  const name = item.json.name || '';\n  const mime = item.json.mimeType || item.json.mime_type || '';\n  return (name.startsWith('Post_') || mime === 'application/vnd.google-apps.folder') && !name.toLowerCase().includes('archive');\n});\n\nif (validFolders.length === 0) {\n  return [];\n}\n\n// Sort folders by folder name descending (Post_YYYYMMDD_HHMMSS) to pick top queue item\nvalidFolders.sort((a, b) => {\n  const nameA = a.json.name || '';\n  const nameB = b.json.name || '';\n  return nameB.localeCompare(nameA);\n});\n\nreturn [validFolders[0]];"
      },
      "id": "node-pick-next-folder",
      "name": "Pick Top Queue Subfolder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "advanced",
        "queryString": "='{{ $json.id }}' in parents and trashed = false",
        "options": {}
      },
      "id": "node-gdrive-list-files",
      "name": "Google Drive: List Files in Subfolder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [920, 300]
    },
    {
      "parameters": {
        "jsCode": "// Classify media and find caption.txt and hashtags.txt\nconst files = $input.all().map(i => i.json);\n\nconst images = files.filter(f => f.mimeType && f.mimeType.startsWith('image/'));\nconst videos = files.filter(f => f.mimeType && f.mimeType.startsWith('video/'));\nconst captionFile = files.find(f => f.name === 'caption.txt' || f.name.endsWith('.txt'));\nconst hashtagsFile = files.find(f => f.name === 'hashtags.txt');\n\nlet mediaType = 'SINGLE_PHOTO';\nif (videos.length > 0) {\n  mediaType = 'VIDEO';\n} else if (images.length > 1) {\n  mediaType = 'CAROUSEL';\n}\n\nreturn {\n  json: {\n    folder_id: $('Pick Top Queue Subfolder').first().json.id,\n    folder_name: $('Pick Top Queue Subfolder').first().json.name,\n    media_type: mediaType,\n    images: images,\n    videos: videos,\n    caption_file_id: captionFile ? captionFile.id : null,\n    hashtags_file_id: hashtagsFile ? hashtagsFile.id : null\n  }\n};"
      },
      "id": "node-classify-media",
      "name": "Classify Media & Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1140, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.IG_USER_ID }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "image_url",
              "value": "={{ $json.images[0] ? 'https://lh3.googleusercontent.com/d/' + $json.images[0].id : '' }}"
            },
            {
              "name": "caption",
              "value": "={{ $json.full_caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-ig-create-container",
      "name": "1. Instagram: Create Media Container",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.IG_USER_ID }}/media_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.IG_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-ig-publish",
      "name": "1b. Instagram: Publish Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1620, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.FB_PAGE_ID }}/photos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Classify Media & Files').first().json.images[0] ? 'https://lh3.googleusercontent.com/d/' + $('Classify Media & Files').first().json.images[0].id : '' }}"
            },
            {
              "name": "caption",
              "value": "={{ $('Classify Media & Files').first().json.full_caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.FB_PAGE_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-fb-publish",
      "name": "2. Facebook: Post Photo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.threads.net/v1.0/me/threads",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "media_type",
              "value": "IMAGE"
            },
            {
              "name": "image_url",
              "value": "={{ $('Classify Media & Files').first().json.images[0] ? 'https://lh3.googleusercontent.com/d/' + $('Classify Media & Files').first().json.images[0].id : '' }}"
            },
            {
              "name": "text",
              "value": "={{ $('Classify Media & Files').first().json.full_caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.THREADS_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-threads-create",
      "name": "3. Threads: Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.threads.net/v1.0/me/threads_publish",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "creation_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "access_token",
              "value": "={{ $env.THREADS_ACCESS_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-threads-publish",
      "name": "3b. Threads: Publish Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1620, 550]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twitter.com/2/tweets",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.X_BEARER_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $('Classify Media & Files').first().json.full_caption.substring(0, 280) }}\"\n}",
        "options": {}
      },
      "id": "node-x-publish",
      "name": "4. X (Twitter): Publish Tweet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 750]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "move",
        "fileId": "={{ $('Classify Media & Files').first().json.folder_id }}",
        "parentFolderId": "1djXkok8cuP3efyurTd2nOwoKRo-HpEC3"
      },
      "id": "node-gdrive-archive",
      "name": "Google Drive: Move to Archive Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [1850, 450]
    },
    {
      "parameters": {
        "jsCode": "// Prepare WhatsApp report message\nconst item = $('Classify Media & Files').first().json;\nconst timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n\nconst reportText = `🚀 *Social Media Post Published!*\\n\\n📂 *Folder*: ${item.folder_name}\\n📝 *Caption*: ${item.caption || 'Published'}\\n#️⃣ *Hashtags*: ${item.hashtags || ''}\\n\\n✅ *Instagram*: Published Live\\n✅ *Facebook*: Published Live\\n✅ *Threads*: Published Live\\n✅ *X (Twitter)*: Published Live\\n\\n⏰ Published at ${timestamp}`;\n\nreturn {\n  json: {\n    ...item,\n    whatsapp_report_text: reportText\n  }\n};"
      },
      "id": "node-compile-report",
      "name": "Compile WhatsApp Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2070, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $env.YOUR_PERSONAL_WHATSAPP_NUMBER }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"{{ $json.whatsapp_report_text }}\"\n  }\n}",
        "options": {}
      },
      "id": "node-send-whatsapp-report",
      "name": "Send WhatsApp Confirmation 📱",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2290, 450]
    }
  ],
