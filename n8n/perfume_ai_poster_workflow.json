            "index": 0
          }
        ]
      ]
    },
    "Telegram: Status 'Analyzing'": {
      "main": [
        [
          {
            "node": "Vision AI (GPT-4o)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Vision AI (GPT-4o)": {
      "main": [
        [
          {
            "node": "Parse Vision & Format Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Vision & Format Prompt": {
      "main": [
        [
          {
            "node": "Telegram: Status 'Generating'",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: Status 'Generating'": {
      "main": [
        [
          {
            "node": "Generate Poster (Flux.1 Schnell/Dev)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Poster (Flux.1 Schnell/Dev)": {
      "main": [
        [
          {
            "node": "Prepare Preview Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Preview Card": {
      "main": [
        [
          {
            "node": "Telegram: Send Poster + Buttons",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Approve Callback?": {
      "main": [
        [
          {
            "node": "Telegram: Confirm Approved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram: Prompt for Changes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
